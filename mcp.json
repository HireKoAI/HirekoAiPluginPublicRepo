{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "HirekoOpenPlugin": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/dist/cli/index.js",
        "serve"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "PLUGIN_NAME": "HirekoOpenPlugin"
      }
    }
  }
}
