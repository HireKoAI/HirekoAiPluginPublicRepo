{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "hireko": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/index.mjs"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "PLUGIN_NAME": "HirekoOpenPlugin",
        "HIREKO_CREDENTIAL_STORE": "file"
      }
    }
  }
}
